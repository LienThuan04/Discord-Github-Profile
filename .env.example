# Lanyard REST base URL (server side). Point this at a self-hosted Lanyard if you run one.
LANYARD_API_URL=https://api.lanyard.rest/v1

# Lanyard WebSocket URL (used by the live card in the browser).
NEXT_PUBLIC_LANYARD_WS_URL=wss://api.lanyard.rest/socket

# Public base URL of this deployment, used to build embed snippets.
# Falls back to the request origin when empty.
NEXT_PUBLIC_SITE_URL=

# --- Discord profile extras (banner, banner color, theme colors, bio, pronouns, effect, all badges) ---
# Lanyard does not carry these. Every source below is optional; cards render without them.

# Optional, official. A Discord bot token enables GET https://discord.com/api/v10/users/{id}, which
# returns the profile banner hash and accent color for any user. Server-side only; never expose it
# to the browser (no NEXT_PUBLIC_ prefix). Create a bot at https://discord.com/developers/applications.
DISCORD_BOT_TOKEN=

# Unofficial third-party profile mirror for bio, pronouns, Nitro theme colors, profile effect and
# the full badge list. `dstn` (default) uses https://dcdn.dstn.to/profile/{id}; `off` disables it.
DISCORD_PROFILE_PROVIDER=dstn
# Base URL of the dstn-compatible mirror (GET {url}/profile/{id}). Empty uses https://dcdn.dstn.to.
DISCORD_PROFILE_PROVIDER_URL=

# Optional durable store for each user's last good profile (Upstash Redis REST). With it, cold starts and
# mirror outages keep the profile frame, effect and badges. Vercel: Marketplace -> Upstash for Redis ->
# connect to the project (it sets KV_REST_API_URL and KV_REST_API_TOKEN). Direct Upstash names also work:
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN. HTTPS only (plain HTTP only for localhost).
# Server-side only. PROFILE_STORE=off ignores them.
KV_REST_API_URL=
KV_REST_API_TOKEN=
PROFILE_STORE=

# Where Card Studio's "Coming soon" tile and footer feedback link point (any http/https URL).
# Server-side, read per request. Empty uses the owner's GitHub profile https://github.com/LienThuan04.
FEEDBACK_URL=
