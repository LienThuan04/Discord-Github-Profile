{
  "name": "discord-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Discord presence cards for GitHub profile READMEs and websites, powered by Lanyard.",
  "author": "LianHarman(LienThuan04)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LienThuan04/Discord-Github-Profile.git"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "examples": "tsx scripts/generate-examples.ts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.16",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "^4.160.1"
  }
}
